# Application
NODE_ENV=development
PORT=7007
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB metadata (required)
# Atlas example: mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=file_media_service

# Test database. The test database name must end in _test.
# MONGO_TEST_URI falls back to MONGO_URI when omitted.
MONGO_TEST_URI=mongodb://localhost:27017
MONGO_TEST_DB_NAME=file_media_service_test

# Storage provider: local for development, s3 for staging/production
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./upload

# Multipart and application validation
MAX_FILE_SIZE_BYTES=10485760
MAX_BULK_FILE_COUNT=10
MAX_BULK_TOTAL_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,audio/mpeg,audio/wav,video/mp4,video/webm

# Required for DELETE /files/:fileId/permanent. Use a long random secret.
HARD_DELETE_ADMIN_KEY=replace-with-a-long-random-secret

# Soft-deleted files are permanently deleted at 03:00 server local time.
# Keep disabled until the retention and monitoring policy is approved.
FILE_PURGE_ENABLED=false
DELETED_FILE_RETENTION_DAYS=30
FILE_PURGE_BATCH_SIZE=100

# S3 configuration (required when STORAGE_PROVIDER=s3)
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=meal-guides-bucket


# ----- API Key Authentication -----
API_KEY_REQUIRED=false  # true in production | false in development
API_KEYS=app_key_core_nestjs,app_key_python_backend,app_key_nextjs

# Short-lived local transfer authorization (optional)
# Generate the signing key securely and keep it server-side.
TRANSFER_AUTHORIZATION_ENABLED=false
TRANSFER_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-characters
TRANSFER_TOKEN_TTL_SECONDS=300
FILE_SERVICE_PUBLIC_URL=http://localhost:7007
TRANSFER_RATE_LIMIT_MAX=30
TRANSFER_RATE_LIMIT_WINDOW_SECONDS=60
